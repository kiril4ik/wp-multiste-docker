DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress_local
DB_ROOT_PASSWORD=root_local

# Project settings. These variable names intentionally match the requested spelling.
IS_MULTISTE=true
MAKE_REPALCE=true
PROD_DOMAIN=example.test

# Disable WordPress and PHP mail while keeping internet access available.
DISABLE_MAIL=true

# Empty = read the original wp-config.php (fallback: wp_).
WP_TABLE_PREFIX=
